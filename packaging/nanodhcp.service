[Unit]
Description=nanodhcp — minimal DHCPv4 server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nanodhcp run -c /etc/nanodhcp/nanodhcp.conf
Restart=on-failure
RestartSec=2

# nanodhcp does not drop privileges itself, so confine it here. A transient
# unprivileged user plus two capabilities is all it needs: bind udp/67 and
# apply SO_BINDTODEVICE to the configured interface.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW

# StateDirectory creates /var/lib/nanodhcp owned by the runtime user and keeps
# it across restarts. Point the config's lease_file at it:
#   lease_file=/var/lib/nanodhcp/leases
StateDirectory=nanodhcp

# Sandbox. nanodhcp only needs to read its config and speak IPv4 UDP.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
